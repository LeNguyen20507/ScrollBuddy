# Anthropic API Key (for Claude)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Brave Search API Key
# Get yours at: https://brave.com/search/api/
BRAVE_API_KEY=BSAxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Server Configuration
PORT=3000
NODE_ENV=development

# n8n Google Calendar Webhook URL
# Set after creating n8n workflow for calendar events
N8N_CALENDAR_WEBHOOK_URL=https://your-n8n-instance/webhook/calendar-event

# n8n Google Tasks Webhook URL  
# Set after creating n8n workflow for tasks
N8N_TASKS_WEBHOOK_URL=https://your-n8n-instance/webhook/google-task

# Legacy webhook URL (kept for backward compatibility)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/create-event

# Data Storage Path
DATA_PATH=.scrollbuddy
